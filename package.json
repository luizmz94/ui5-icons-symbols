{
  "name": "ui5-icons-symbols",
  "displayName": "UI5 Icons Symbols",
  "publisher": "luizmz94",
  "description": "Displays SAP UI5 icons next to their URIs",
  "version": "1.0.9",
  "repository": {
    "type": "git",
    "url": "https://github.com/luizmz94/ui5-icons-symbols.git"
  },
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Other"
  ],
  "icon": "icon.png",
  "activationEvents": [
    "onLanguage:html",
    "onLanguage:xml",
    "onLanguage:javascript",
    "onLanguage:typescript",
    "onStartupFinished",
    "onCompletionItemSelected"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "ui5-icons-symbols.helloWorld",
        "title": "Hello World"
      }
    ],
    "languages": [
      {
        "id": "html",
        "extensions": [
          ".html"
        ],
        "aliases": [
          "HTML"
        ]
      },
      {
        "id": "xml",
        "extensions": [
          ".xml"
        ],
        "aliases": [
          "XML"
        ]
      },
      {
        "id": "javascript",
        "extensions": [
          ".js"
        ],
        "aliases": [
          "JavaScript"
        ]
      },
      {
        "id": "typescript",
        "extensions": [
          ".ts"
        ],
        "aliases": [
          "TypeScript"
        ]
      }
    ]
  },
  "scripts": {
    "vscode:prepublish": "npm run compile && npm run postbuild",
    "compile": "tsc -p ./",
    "postbuild": "node scripts/copy-svgs.js",
    "watch": "tsc -watch -p ./",
    "pretest": "npm run compile && npm run lint",
    "lint": "eslint src",
    "test": "vscode-test"
  },
  "devDependencies": {
    "@types/mocha": "^10.0.10",
    "@types/node": "^25.6.0",
    "@types/vscode": "^1.85.0",
    "@typescript-eslint/eslint-plugin": "^8.59.0",
    "@typescript-eslint/parser": "^8.59.0",
    "@vscode/test-cli": "^0.0.11",
    "@vscode/test-electron": "^2.5.2",
    "eslint": "^10.2.1",
    "typescript": "^6.0.3"
  },
  "dependencies": {
    "fontfaceobserver": "^2.3.0"
  },
  "overrides": {
    "diff": "^9.0.0",
    "serialize-javascript": "^7.0.5"
  }
}
